# RepairDom - Frontend
# Copier ce fichier en `.env.local` et remplacer par vos vraies valeurs.
# Seules les variables préfixées NEXT_PUBLIC_ sont exposées au navigateur.

# URL publique de l'application (utilisée pour les liens canoniques).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# URL de base de l'API backend (NestJS).
# Local : http://localhost:3000/api
# Sur Vercel, pointer vers l'URL publique du backend déployé sur Railway.
NEXT_PUBLIC_API_URL=http://localhost:3000/api