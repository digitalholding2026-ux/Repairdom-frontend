{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  // Test unitaire Node natif (`npm run test:unit`) : jamais bundlé, imports
  // `.ts` explicites exigés par Node — exclu du typecheck Next.
  "exclude": ["node_modules", "src/lib/notifications/notification-mapping.test.ts", "src/lib/technician-kyc.test.ts", "src/lib/payment-helpers.test.ts", "src/lib/gps-helpers.test.ts", "src/lib/error-handling.test.ts", "src/lib/navigation.test.ts", "src/lib/design-system.test.ts", "src/lib/responsive.test.ts", "src/lib/lottie.test.ts", "src/lib/demande-media.test.ts", "src/lib/catalog-scales.test.ts", "src/lib/diagnostic-libre.test.ts", "src/lib/ai-classification.test.ts", "src/components/admin/ai/ai-dashboard-helpers.test.ts", "src/lib/dispute-status.test.ts", "src/lib/password-reset.test.ts", "src/lib/role-guard.test.ts", "src/lib/modal-focus.test.ts", "src/lib/no-middleware.test.ts", "src/lib/realtime/sse-client.test.ts", "src/lib/realtime/realtime-hooks.test.ts", "src/lib/format-fcfa.test.ts", "src/lib/push/push-client.test.ts", "src/lib/technician/onboarding-steps.test.ts", "src/lib/rewards-view.test.ts"]
}